{
  "manifest_version": 3,
  "name": "MyBeam",
  "version": "1.1.2",
  "description": "Bridges web AI chat sites to the local MyBeam Workstation server.",
  "permissions": [
    "alarms",
    "tabs",
    "windows",
    "storage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3210/*",
    "https://oxalpha.com/*",
    "https://*.oxalpha.com/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://oxalpha.com/*",
        "https://*.oxalpha.com/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "content-core/utils.js",
        "content-providers/oxalpha.js",
        "content-providers/deepseek.js",
        "content-core/core.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "MyBeam"
  }
}
